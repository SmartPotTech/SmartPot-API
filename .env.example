# Copia este archivo como .env para ejecutar la API en local (go run ./cmd/api).

# Servidor
PORT=8091
# Detrás de nginx u otro proxy: true para tomar la IP del cliente de X-Forwarded-For (si no, el límite de tasa
# sería uno solo para todos). Solo se confía en la cabecera si la conexión llega desde TRUSTED_PROXY_CIDRS
# (vacío = redes privadas, loopback y link-local). Sin proxy, déjalo en false.
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=INFO
WEB_BASE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8091
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_DOCS_ENABLED=true

# Secretos: JWT de al menos 32 caracteres y AES-256 en Base64 (openssl rand -base64 32)
SMARTPOT_JWT_SECRET=<JWT_SECRET_MIN_32_CHARS>
SMARTPOT_AES_KEY=<BASE64_32_BYTES>
JWT_EXPIRATION=P7D

# PostgreSQL + TimescaleDB
DATABASE_URL=postgres://smartpot:<DB_PASSWORD>@localhost:5432/smartpot?sslmode=disable
DATABASE_MAX_CONNS=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>

# Correo (Mailpit en local)
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=<MAIL_USERNAME>
MAIL_PASSWORD=<MAIL_PASSWORD>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=false
MAIL_FROM=SmartPot <no-reply@smartpot.app>

# MQTT: la API es la cuenta administradora del broker
MQTT_ENABLED=true
MQTT_BROKER_URI=tcp://localhost:1883
MQTT_ADMIN_USERNAME=smartpot-api
MQTT_ADMIN_PASSWORD=<MQTT_ADMIN_PASSWORD>
MQTT_PUBLIC_HOST=localhost
MQTT_PUBLIC_PORT=1883
MQTT_PUBLIC_TLS=false
MQTT_WEBSOCKET_URL=ws://localhost:9001

# Asistente de IA (servicio interno)
AI_ENABLED=true
AI_BASE_URL=http://localhost:8000
SMARTPOT_AI_TOKEN=<AI_SERVICE_TOKEN>
AI_EVALUATION_INTERVAL=PT5M
AI_AUTOMATION_COOLDOWN=PT10M
# Aprendizaje continuo: cada cuánto se envían las lecturas reales a la IA
AI_LEARNING_ENABLED=true
AI_LEARNING_FLUSH_INTERVAL=PT1M

# Telegram (opcional): crea el bot con @BotFather. polling en local; webhook en producción.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# Cultivos virtuales (SmartPot-DataGenerator con su API de control); sin token no se pueden crear
SIMULATOR_ENABLED=true
SIMULATOR_BASE_URL=http://localhost:8081
SIMULATOR_TOKEN=<SIMULATOR_SERVICE_TOKEN>
